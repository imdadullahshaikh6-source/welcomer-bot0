import io
import os
import json
import base64
import urllib.request
from PIL import Image

from pyrogram import Client, filters
from pyrogram.types import Message
from pyrogram.raw.functions.messages import GetStickerSet, SendMedia
from pyrogram.raw.functions.stickers import CreateStickerSet, AddStickerToSet
from pyrogram.raw.types import (
    InputStickerSetShortName,
    InputStickerSetItem,
    InputDocument,
)
from pyrogram.errors import StickersetInvalid

QUOTLY_ENDPOINTS = [
    "https://quote.antispam.bot/generate",
    "https://quotly.herokuapp.com/generate",
    "https://quote.yuri.ly/generate"
]

def generate_quotly_sticker(payload: dict) -> io.BytesIO:
    data = json.dumps(payload).encode("utf-8")
    raw_response = None

    for url in QUOTLY_ENDPOINTS:
        try:
            req = urllib.request.Request(
                url,
                data=data,
                headers={
                    "Content-Type": "application/json",
                    "User-Agent": "Mozilla/5.0"
                }
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                if resp.status == 200:
                    raw_response = resp.read()
                    break
        except Exception:
            continue

    if not raw_response:
        return None

    res_json = json.loads(raw_response.decode("utf-8"))
    if not res_json.get("ok"):
        return None

    image_bytes = base64.b64decode(res_json["result"]["image"])
    output = io.BytesIO(image_bytes)
    output.name = "quote.webp"
    return output


# ------------------ 1. .qr (QUOTE REPLY) ------------------ #
@Client.on_message(filters.command(["qr"], prefixes=[".", "!", "/"]))
async def quote_reply_cmd(client: Client, message: Message):
    if not message.reply_to_message:
        return await message.reply_text("❗ Kisi message par reply karke `.qr` use karein!")

    target = message.reply_to_message
    status_msg = await message.reply_text("💬 *Quoting with reply...*")

    # Target message details
    sender = target.from_user
    name = sender.first_name if sender else "Unknown"
    user_id = sender.id if sender else 0

    message_obj = {
        "entities": [],
        "avatar": True,
        "from": {
            "id": user_id,
            "first_name": name,
            "last_name": sender.last_name if sender and sender.last_name else "",
            "username": sender.username if sender and sender.username else ""
        },
        "text": target.text or target.caption or ""
    }

    # Agar target message bhi kisi ka reply hai to nested reply show karega
    if target.reply_to_message:
        rep = target.reply_to_message
        rep_sender = rep.from_user
        rep_name = rep_sender.first_name if rep_sender else "Unknown"
        message_obj["replyMessage"] = {
            "name": rep_name,
            "text": rep.text or rep.caption or "Media",
            "chatId": rep.chat.id
        }

    payload = {
        "type": "quote",
        "format": "webp",
        "backgroundColor": "#1b1429",
        "width": 512,
        "height": 768,
        "scale": 2,
        "messages": [message_obj]
    }

    sticker = generate_quotly_sticker(payload)
    if not sticker:
        return await status_msg.edit_text("❌ Quote generate nahi ho paya. Dobara try karein!")

    await client.send_sticker(
        chat_id=message.chat.id,
        sticker=sticker,
        reply_to_message_id=target.id
    )
    await status_msg.delete()


# ------------------ 2. .kang (STICKER STEAL) ------------------ #
@Client.on_message(filters.command(["kang"], prefixes=[".", "!", "/"]))
async def kang_cmd(client: Client, message: Message):
    if not message.reply_to_message:
        return await message.reply_text("❗ Kisi sticker ya photo par reply karke `.kang` use karein!")

    rep = message.reply_to_message
    if not (rep.sticker or rep.photo or rep.document):
        return await message.reply_text("❗ Sirf Sticker, Photo ya Image document hi kang ho sakta hai!")

    status_msg = await message.reply_text("⚡ *Processing sticker...*")

    # Emoji detect karein
    emoji = "🤔"
    if len(message.command) > 1:
        emoji = message.command[1]
    elif rep.sticker and rep.sticker.emoji:
        emoji = rep.sticker.emoji

    # Media download & resize to 512x512 WEBP
    media_path = await client.download_media(rep)
    img = Image.open(media_path).convert("RGBA")
    maxsize = (512, 512)
    img.thumbnail(maxsize, Image.Resampling.LANCZOS)

    output_path = f"kang_{message.from_user.id}.webp"
    img.save(output_path, "WEBP")
    if os.path.exists(media_path):
        os.remove(media_path)

    # Document upload via Pyrogram
    sent_doc = await client.send_document(
        chat_id="me",
        document=output_path,
        force_document=True
    )
    if os.path.exists(output_path):
        os.remove(output_path)

    user = message.from_user
    bot_username = (await client.get_me()).username
    pack_num = 1
    pack_name = f"a{user.id}_pack{pack_num}_by_{bot_username}"
    pack_title = f"{user.first_name}'s Kang Pack Vol.{pack_num}"

    raw_doc = InputDocument(
        id=sent_doc.document.file_id,
        access_hash=sent_doc.document.file_ref,
        file_reference=sent_doc.document.file_ref
    )

    sticker_item = InputStickerSetItem(
        document=raw_doc,
        emoji=emoji
    )

    # Pack check / create
    try:
        await client.invoke(
            GetStickerSet(
                stickerset=InputStickerSetShortName(short_name=pack_name),
                hash=0
            )
        )
        # Pack exist karta hai to add karein
        await client.invoke(
            AddStickerToSet(
                stickerset=InputStickerSetShortName(short_name=pack_name),
                sticker=sticker_item
            )
        )
    except StickersetInvalid:
        # Pack nahi hai to naya banayein
        await client.invoke(
            CreateStickerSet(
                user_id=await client.resolve_peer(user.id),
                title=pack_title,
                short_name=pack_name,
                stickers=[sticker_item]
            )
        )
    except Exception as e:
        return await status_msg.edit_text(f"❌ Error aaya kang me: `{e}`")

    await status_msg.edit_text(
        f"✅ **Sticker Kanged Successfully!**\n\n"
        f"✨ **Emoji:** {emoji}\n"
        f"📦 **Pack:** [Click Here](https://t.me/addstickers/{pack_name})",
        disable_web_page_preview=True
    )
    
